# ==========================================================
# Application database (the platform's own Postgres, NOT a
# customer's database). Docker Compose already sets this up.
# ==========================================================
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_NAME=platform_db
APP_DB_USER=platform_user
APP_DB_PASSWORD=platform_password

# ==========================================================
# Security — you MUST change both of these before running.
#
# JWT_SECRET_KEY: any long random string. It signs login tokens.
# Generate one with (no installs needed, uses a throwaway Docker container):
#   docker run --rm python:3.11-slim python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# ENCRYPTION_KEY: must be a "Fernet" key (a specific format) because it
# encrypts customer database passwords before they're stored. Generate with:
#   docker run --rm python:3.11-slim python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Paste the output of each command below, replacing the placeholder text.
# ==========================================================
JWT_SECRET_KEY=replace-with-the-output-of-the-first-command-above
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ENCRYPTION_KEY=replace-with-the-output-of-the-second-command-above

# ==========================================================
# LLM provider (used for SQL generation and chat answers).
# Works with any OpenAI-compatible endpoint. For Groq, use:
#   OPENAI_API_KEY   = your Groq API key (from https://console.groq.com/keys)
#   OPENAI_BASE_URL  = https://api.groq.com/openai/v1
#   LLM_MODEL        = a current Groq model, e.g. llama-3.3-70b-versatile
# (For plain OpenAI instead, use OPENAI_BASE_URL=https://api.openai.com/v1
#  and LLM_MODEL=gpt-4o-mini.)
# ==========================================================
OPENAI_API_KEY=your-groq-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ==========================================================
# Document embeddings — these run LOCALLY inside the API
# container (no API key, no cost, works with any LLM provider
# including Groq, since Groq itself has no embeddings API).
# The model downloads automatically (~130MB) on first use.
# ==========================================================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ==========================================================
# File storage (local disk folder mounted by docker-compose)
# ==========================================================
FILE_STORAGE_PATH=/app/storage/files

# ==========================================================
# Query safety limits
# ==========================================================
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SECONDS=15

# ==========================================================
# Default seeded tenant/admin (created automatically on first boot)
# ==========================================================
DEFAULT_TENANT_NAME=Demo Company
DEFAULT_TENANT_CODE=demo
DEFAULT_ADMIN_EMAIL=admin@demo.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ==========================================================
# General
# ==========================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
